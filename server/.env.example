# ===== GEO AI Agent 模型接入 =====
# 每个平台三个变量：_KEY（填了才启用真实调用）/ _BASE（接口地址）/ _MODEL
# 未填 KEY 的平台自动走模拟数据，界面上会明确标注「模拟」，不会被当成真实结果

# DeepSeek —— https://platform.deepseek.com
GEO_DEEPSEEK_KEY=
GEO_DEEPSEEK_BASE=https://api.deepseek.com/v1
GEO_DEEPSEEK_MODEL=deepseek-chat

# Kimi / Moonshot —— https://platform.moonshot.cn
GEO_KIMI_KEY=
GEO_KIMI_BASE=https://api.moonshot.cn/v1
GEO_KIMI_MODEL=moonshot-v1-8k

# 通义千问（阿里云百炼 OpenAI 兼容模式）—— https://bailian.console.aliyun.com
GEO_QWEN_KEY=
GEO_QWEN_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
GEO_QWEN_MODEL=qwen-plus

# 豆包（火山方舟）—— https://console.volcengine.com/ark
# 注意：MODEL 要填「推理接入点 ID」（形如 ep-2025xxxx），不是模型名
GEO_DOUBAO_KEY=
GEO_DOUBAO_BASE=https://ark.cn-beijing.volces.com/api/v3
GEO_DOUBAO_MODEL=

# 文心（百度千帆 v2，OpenAI 兼容）—— https://console.bce.baidu.com/qianfan
GEO_WENXIN_KEY=
GEO_WENXIN_BASE=https://qianfan.baidubce.com/v2
GEO_WENXIN_MODEL=ernie-4.0-8k

# 腾讯元宝：C 端无公开 API，此处用混元模型近似（答案风格与元宝 App 有差异）
GEO_YUANBAO_KEY=
GEO_YUANBAO_BASE=https://api.hunyuan.cloud.tencent.com/v1
GEO_YUANBAO_MODEL=hunyuan-turbos-latest

# ===== 安全 =====
# 生产环境必须改成随机长字符串，否则登录态可被伪造
GEO_TOKEN_SECRET=change-me-in-production

# ===== SEO 曝光率（可选） =====
# 不填也能用：站点可索引性走真实抓取，关键词排名不编数据，可手工录入站长平台导出值
# 填了才启用 live 通道：逐个关键词查搜索结果位次 + site: 收录数
# 推荐 SerpAPI：在 https://serpapi.com 注册后从 Dashboard 复制 api_key
#   BASE 填 https://serpapi.com/search.json，KEY 填 api_key，ENGINE 选 google / baidu / bing
# 注意：Bing Web Search v7 已于 2025-08-11 退役（v7 端点返回 410），不要再申请该订阅密钥。
#       若改接 Azure Grounding with Bing 或自建/第三方兼容搜索代理，
#       响应需含 organic_results / webPages.value / results / items 之一（见 seo.js 的 querySerp）。
# 非 serpapi 的 BASE 会用 Ocp-Apim-Subscription-Key 请求头传递 KEY
# GEO_SEO_SEARCH_KEY=
# GEO_SEO_SEARCH_BASE=
# GEO_SEO_SEARCH_ENGINE=google
# 定时扫描间隔（分钟）；0 或不填 = 关闭，只手动点「开始扫描」
# GEO_SEO_SCAN_INTERVAL_MIN=0

# ===== 其他 =====
# PORT=8002
# GEO_DB_PATH=./data/geo.db
